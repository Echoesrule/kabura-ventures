SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret

# Optional JWT claims (defaults are fine)
# JWT_ISSUER=kabura-adventures-api
# JWT_AUDIENCE=kabura-adventures-web

# Comma-separated list of origins allowed to call this API with credentials.
# REQUIRED in production; without it CORS is locked down to localhost only.
# Example: https://kabura-ventures.vercel.app,http://localhost:3000
# TRUSTED_ORIGINS=https://kabura-ventures.vercel.app

# Admin account: the app ONLY creates an admin when both are set. There is no
# hardcoded default admin password. ADMIN_PASSWORD must be at least 12 chars.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-random-password

# Only set to true when this app sits behind a trusted reverse proxy that
# overwrites X-Forwarded-For / X-Forwarded-Proto (e.g. nginx, Render). Keeps
# clients from spoofing their IP to bypass rate limiting.
# TRUST_PROXY_HEADERS=false

# Database (SQLite by default; uncomment for PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/kabura_adventures

# Supabase configuration
# Find these in your Supabase project dashboard: Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional: Supabase storage bucket name (default: kabura)
# SUPABASE_STORAGE_BUCKET=kabura

# SMTP configuration for direct email sending (optional)
# If configured, the backend sends 6-digit OTP codes directly via SMTP.
# If not configured, falls back to Supabase's email service.
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@kaburaadventures.com
# SMTP_USE_TLS=true

# CORS: comma-separated origins allowed (optional; defaults to * if unset)
TRUSTED_ORIGINS=https://kabura-ventures.onrender.com,http://localhost:5000

FLASK_DEBUG=1
